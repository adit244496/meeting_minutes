# ---------- Core ----------
SECRET_KEY=
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# ---------- Datastores ----------
# Defaults are for a NATIVE install (services on localhost). docker-compose
# overrides both with its container hostnames, so you do not edit these to
# run locally in Docker.
DATABASE_URL=postgresql+psycopg://mm:mm@127.0.0.1:5432/meeting_minutes
REDIS_URL=redis://127.0.0.1:6379/0

# ---------- Recording storage ----------
# local = plain files on disk (default, no external dependency).
# s3    = AWS S3 or any S3-compatible store; fill in the block below.
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./recordings

# Recordings are auto-deleted after this many days. Transcripts, speakers and
# minutes are kept indefinitely - only the audio is removed. Set 0 to disable.
RECORDING_RETENTION_DAYS=7

# Only used when STORAGE_BACKEND=s3
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_REGION=ap-south-1

# ---------- ASR provider ----------
# gemini | elevenlabs | sarvam
# Gemini is the default: it handles code-switched English/Hindi/Bengali better
# than the dedicated ASR engines, because it can be instructed about mixing
# whereas they decode one language per window. It is also ~5x cheaper.
ASR_PROVIDER=gemini
GEMINI_API_KEY=
# gemini-2.5-flash is the cheaper, older alternative.
GEMINI_MODEL=gemini-3.8-flash

# Alternatives - only needed if you switch ASR_PROVIDER
ELEVENLABS_API_KEY=
SARVAM_API_KEY=

# ---------- Pipeline phases ----------
# Phase 1 (both false): transcript only - speakers separated as "Speaker 1/2/3",
#   no voiceprint matching, no minutes. Validate ASR quality here first.
# Phase 2: flip AUTO_IDENTIFY_SPEAKERS once users have enrolled voice samples.
# Phase 3: flip AUTO_GENERATE_MINUTES to produce minutes on every meeting.
# Minutes are always available on demand from the meeting page regardless.
AUTO_IDENTIFY_SPEAKERS=false
AUTO_GENERATE_MINUTES=true

# ---------- Minutes generation ----------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
MINUTES_LANGUAGE=en

# ---------- Speaker identification ----------
# Cosine similarity threshold for matching a diarized cluster to an enrolled
# voiceprint. MUST be tuned on your own audio - see README.
SPEAKER_MATCH_THRESHOLD=0.35
SPEAKER_EMBED_SECONDS=30
