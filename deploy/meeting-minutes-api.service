[Unit]
Description=Meeting Minutes API (FastAPI)
Documentation=https://github.com/adit244496/meeting_minutes
After=network-online.target postgresql.service redis-server.service
Wants=network-online.target

[Service]
Type=exec
User=meetingminutes
Group=meetingminutes
WorkingDirectory=/opt/meeting-minutes/backend

# systemd parses this itself - it is not a shell. Do not quote values, do not
# use $VAR expansion, and keep '#' out of the middle of a value.
EnvironmentFile=/opt/meeting-minutes/.env

# Bound to localhost on purpose: nginx is the only thing that should reach it.
ExecStart=/opt/meeting-minutes/venv/bin/uvicorn app.main:app \
    --host 127.0.0.1 --port 8000 --proxy-headers --forwarded-allow-ips=127.0.0.1

Restart=on-failure
RestartSec=5
TimeoutStopSec=30

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
# The only paths the service may write to.
ReadWritePaths=/var/lib/meeting-minutes

[Install]
WantedBy=multi-user.target
