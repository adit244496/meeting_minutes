# Normalise line endings: LF in the repository, native in the working copy.
# Without this, a Windows checkout commits CRLF and the Linux server sees the
# whole tree as modified.
* text=auto eol=lf

# Shell scripts and systemd units must be LF even on Windows checkouts.
*.sh    text eol=lf
*.service text eol=lf
*.conf  text eol=lf

# Never touch these.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.svg   text
*.wav   binary
*.mp3   binary
*.m4a   binary
*.webm  binary
*.flac  binary
*.pdf   binary
